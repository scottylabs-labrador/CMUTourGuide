{
  "expo": {
    "name": "CMU Explorer",
    "slug": "TourGuide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/CMUCE_nobars.png",
    "scheme": "tourguide",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bigboa19.TourGuide",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "CMU Campus Explorer uses your location to show your position on the campus map."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.bigboa19.TourGuide"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/CMUCE_nobars.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#C41230",
          "dark": {
            "backgroundColor": "#C41230"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CMU Explorer uses the camera to scan campus buildings and identify them.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-dev-client",
        {
          "addGeneratedScheme": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CMU Explorer uses your location to show your position on the campus map.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-font",
      [
        "react-native-maps",
        {
          "iosGoogleMapsApiKey": "AIzaSyA2UL82O5NP-hY4x1WeoOKbKqiXq1GEUko"
        }
      ]
    ],
    "developmentClient": {
      "silentLaunch": true
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ed9be8d-fbc9-4812-b934-99b2e359f21b"
      }
    }
  }
}
